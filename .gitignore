# Build output
bin/

# Local scratch tmpdir for `go test` binaries (/tmp is noexec in some sandboxes)
.gotmp/

# Local Go build cache (/tmp is noexec in some sandboxes)
.gocache3/

# bv (beads viewer) local config and caches
.bv/

# br (beads) local files — the sqlite db and its sidecars are rebuilt from
# the committed issues.jsonl and must never be tracked
.beads/.br_history
.beads/.br_recovery
.beads/beads.db*

# Per-run pipeline artifacts — regenerated by every mint run; only the absorb
# marks are durable input and stay tracked
.spex/runs/*
!.spex/runs/absorb.json

# Hook violation log (per-machine)
.claude/hook-violations.log

# Per-session skill-ownership markers
.claude/skill-sessions/
.claude/settings.local.json
