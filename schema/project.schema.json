{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spexmachina.dev/schema/project.json",
  "title": "Spex Machina Project",
  "description": "Schema for the project-level spec file (project.json). Defines project metadata, top-level requirements, module declarations with inter-module dependencies, and milestones. IDs are 12-character hex identity hashes.",
  "type": "object",
  "required": ["name", "modules"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Project name."
    },
    "description": {
      "type": "string",
      "description": "Project description."
    },
    "version": {
      "type": "string",
      "description": "Project version string."
    },
    "requirements": {
      "type": "array",
      "description": "Project-level requirements (functional and non-functional).",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "modules": {
      "type": "array",
      "description": "Module declarations. Each module has its own directory with a module.json.",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "milestones": {
      "type": "array",
      "description": "Project milestones that group modules.",
      "items": { "$ref": "#/$defs/milestone" }
    },
    "test_plan": {
      "type": "object",
      "description": "Project-level test plan for cross-module and end-to-end scenarios.",
      "additionalProperties": false,
      "properties": {
        "scenarios": {
          "type": "array",
          "description": "Cross-module test scenarios.",
          "items": { "$ref": "#/$defs/test_scenario" }
        }
      }
    },
    "sections": {
      "type": "array",
      "description": "Project-level sections with typed envelopes and freeform content.",
      "items": { "$ref": "#/$defs/section" }
    }
  },
  "$defs": {
    "identityHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{12}$",
      "description": "12-character hex identity hash (see schema.IdentityHash)."
    },
    "requirement": {
      "$comment": "NOTE: This definition mirrors the one in module.schema.json. Project requirements carry priority; module requirements carry preq_id.",
      "type": "object",
      "required": ["id", "type", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identityHash" },
        "type": {
          "type": "string",
          "enum": ["functional", "non_functional"],
          "description": "Requirement type."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Short requirement title."
        },
        "description": {
          "type": "string",
          "description": "Detailed requirement description."
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Requirement priority (0-4). Optional; enforced by validator when present."
        },
        "depends_on": {
          "type": "array",
          "description": "Identity hashes of other requirements this one depends on (depends_on edge).",
          "items": { "$ref": "#/$defs/identityHash" },
          "uniqueItems": true
        }
      }
    },
    "module": {
      "type": "object",
      "required": ["id", "name", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identityHash" },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Module name."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the module directory containing module.json."
        },
        "description": {
          "type": "string",
          "description": "Module description."
        },
        "requires_module": {
          "type": "array",
          "description": "Identity hashes of other modules this one depends on (requires_module edge).",
          "items": { "$ref": "#/$defs/identityHash" },
          "uniqueItems": true
        }
      }
    },
    "test_scenario": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identityHash" },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Test scenario name."
        },
        "description": {
          "type": "string",
          "description": "Test scenario description."
        },
        "content": {
          "type": "string",
          "description": "Relative path to the markdown file with test scenario details (described_in edge to content leaf)."
        },
        "modules": {
          "type": "array",
          "description": "Module identity hashes involved in this test scenario (modules edge).",
          "items": { "$ref": "#/$defs/identityHash" },
          "uniqueItems": true
        }
      }
    },
    "milestone": {
      "type": "object",
      "required": ["id", "title"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identityHash" },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "Milestone title."
        },
        "description": {
          "type": "string",
          "description": "Milestone description."
        },
        "groups": {
          "type": "array",
          "description": "Module identity hashes grouped under this milestone (groups edge).",
          "items": { "$ref": "#/$defs/identityHash" },
          "uniqueItems": true
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/identityHash" },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Section name."
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Section type (e.g. 'coupled')."
        }
      }
    }
  }
}
