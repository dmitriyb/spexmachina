{
  "node_types": [
    {
      "name": "requirement",
      "plural_key": "requirements",
      "scope": "project",
      "completeness_trigger": true,
      "fields": [
        {
          "name": "type",
          "kind": "text",
          "required": true,
          "enum": [
            "functional",
            "non_functional"
          ],
          "description": "Requirement type."
        },
        {
          "name": "priority",
          "kind": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "Requirement priority (0-4). Optional; enforced by validator when present."
        },
        {
          "name": "derivation",
          "kind": "text",
          "enum": [
            "pending"
          ],
          "description": "Declares a requirement not yet derived into any module. Project-scoped only: a module requirement derives by construction through its required preq_id."
        },
        {
          "name": "depends_on",
          "kind": "reference",
          "cardinality": "many",
          "description": "Identity hashes of other requirements this one depends on (depends_on edge)."
        }
      ]
    },
    {
      "name": "requirement",
      "plural_key": "requirements",
      "scope": "module",
      "completeness_trigger": true
    },
    {
      "name": "endpoint",
      "plural_key": "endpoints",
      "scope": "module"
    }
  ],
  "edges": [
    {
      "kind": "preq_id",
      "from": [
        "requirement"
      ],
      "to": [
        "requirement"
      ]
    },
    {
      "kind": "implements",
      "from": [
        "endpoint"
      ],
      "to": [
        "requirement"
      ]
    }
  ],
  "coverage_chains": [
    {
      "covered_type": "requirement",
      "covered_scope": "project",
      "edge": "preq_id",
      "covering_type": "requirement",
      "covering_scope": "module"
    },
    {
      "covered_type": "requirement",
      "covered_scope": "module",
      "edge": "implements",
      "covering_type": "endpoint"
    }
  ]
}
