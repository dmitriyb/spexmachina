#!/usr/bin/env bash
# setup-hooks — one-time per clone. Wires git's core.hooksPath at the
# repo-tracked scripts/git-hooks directory and makes every hook script
# executable. Claude Code hooks need no setup — they are read from
# .claude/settings.json and the skills' frontmatter automatically.
#
# See docs/enforcement-rfc.md.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

git config core.hooksPath scripts/git-hooks
chmod +x scripts/git-hooks/* \
         scripts/hooks/*.sh \
         scripts/hooks/log-violation \
         scripts/hooks/test/*.sh \
         scripts/setup-hooks \
         scripts/verify-enforcement 2>/dev/null || true

echo "git hooks active at scripts/git-hooks"
echo "CC hooks read from .claude/settings.json + skills' frontmatter"
