#!/usr/bin/env bash
# pre-commit — enforce before the commit object is written:
#   R1  Never commit directly to `main` (CLAUDE.md:37)
#   R5a Commit signing must be enabled (CLAUDE.md:40)

set -uo pipefail

# Resolve the library relative to THIS script's path (not via
# git rev-parse --show-toplevel — that points at the repo running git,
# which may differ from the repo where the hook scripts actually live,
# especially under core.hooksPath pointing at another checkout).
hook_dir="$(cd "$(dirname "$0")" && pwd)"
lib_dir="$(cd "$hook_dir/../hooks/lib" 2>/dev/null && pwd || true)"
if [[ -z "$lib_dir" || ! -f "$lib_dir/emit-halt.sh" ]]; then
  echo "pre-commit: cannot locate scripts/hooks/lib/emit-halt.sh (looked from $hook_dir)" >&2
  exit 1
fi
source "$lib_dir/emit-halt.sh"

# --- R1: no commits to main --------------------------------------------------
# git symbolic-ref --short HEAD returns the branch name even on unborn
# branches (no commits yet), unlike `rev-parse --abbrev-ref HEAD` which
# returns the literal "HEAD" pre-first-commit.
branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo '')"
if [[ "$branch" == "main" ]]; then
  emit_git_halt \
    "no-commits-to-main" \
    "git commit on branch main" \
    "main is protected; never commit directly to it. All changes land via a dedicated branch + PR merge." \
    "CLAUDE.md:37" \
    "Create a feature branch from origin/main: git switch -c <branch>; git push -u origin <branch>" false \
    "If genuinely exceptional (emergency hotfix), the user disables core.hooksPath out-of-band — the agent must not" true
  exit 1
fi

# --- R5a pre-commit half: signing config must be enabled --------------------
# `git config --get` returns the effective value with local-over-global
# precedence applied, so checking the bare key is correct here.
gpgsign="$(git config --get commit.gpgsign 2>/dev/null || echo '')"
if [[ "$gpgsign" != "true" ]]; then
  emit_git_halt \
    "unsigned-commit-detected" \
    "git commit with commit.gpgsign != true (effective: '$gpgsign')" \
    "Commits must be SSH-signed. Never bypass signing." \
    "CLAUDE.md:40" \
    "Set: git config --global commit.gpgsign true" false \
    "And ensure user.signingkey is set: git config --global user.signingkey <ssh-key-path>" false
  exit 1
fi

exit 0
