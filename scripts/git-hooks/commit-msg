#!/usr/bin/env bash
# commit-msg — enforce before the commit object is written:
#   R15 Commit messages must not exceed two sentences (CLAUDE.md:44)
#
# Hard backstop for the CLAUDE.md conciseness rule. Measures the message
# prose — git comment lines and trailers excluded — against a char cap.

set -uo pipefail

# Resolve the library relative to THIS script's path (see pre-commit for
# why git rev-parse --show-toplevel is wrong under core.hooksPath).
hook_dir="$(cd "$(dirname "$0")" && pwd)"
lib_dir="$(cd "$hook_dir/../hooks/lib" 2>/dev/null && pwd || true)"
if [[ -z "$lib_dir" || ! -f "$lib_dir/emit-halt.sh" ]]; then
  echo "commit-msg: cannot locate scripts/hooks/lib/emit-halt.sh (looked from $hook_dir)" >&2
  exit 1
fi
source "$lib_dir/emit-halt.sh"

limit=500
msg_file="$1"

# Count message prose only: drop git comment lines (#...) and trailer
# lines (Co-Authored-By:, Signed-off-by:) — mechanical, not prose.
prose="$(grep -ivE '^(#|co-authored-by:|signed-off-by:)' "$msg_file" || true)"
chars="$(printf '%s' "$prose" | wc -m | tr -d ' ')"

if (( chars > limit )); then
  emit_git_halt \
    "commit-message-too-long" \
    "git commit with a ${chars}-character message (limit ${limit})" \
    "Commit messages must not exceed two full sentences; message prose must stay under ${limit} characters." \
    "CLAUDE.md:44" \
    "Rewrite the message to at most two sentences: what changed, and why if non-obvious" false \
    "Re-run the commit with the shortened message" false
  exit 1
fi

exit 0
