#!/usr/bin/env bash
# log-violation — append one spex-halt/v1 JSON line to
# .claude/hook-violations.log, prefixed with a ts field. Reads the
# canonical inner payload from stdin.
#
# Usage:
#   printf '%s\n' "$inner_json" | scripts/hooks/log-violation
#
# The log file is gitignored. If .claude/ does not exist yet, it is
# created. Errors are non-fatal — logging must never block a hook.

set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
log_dir="$repo_root/.claude"
log_file="$log_dir/hook-violations.log"

mkdir -p "$log_dir" 2>/dev/null || exit 0

ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

# Read inner payload from stdin; prepend ts; append as one compact line.
jq -c --arg ts "$ts" '. + {ts: $ts} | {ts} + .' >> "$log_file" 2>/dev/null || exit 0
