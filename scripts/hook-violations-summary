#!/usr/bin/env bash
# hook-violations-summary — rollup of .claude/hook-violations.log.
#
# Each line in the log is a JSON object with at minimum {ts, rule,
# command, cwd, head, skill}. This script prints a frequency count by
# rule (default) plus the most recent commands per rule.
#
# Usage:
#   scripts/hook-violations-summary                       # all rules, frequency
#   scripts/hook-violations-summary --rule <slug>         # one rule, every entry
#   scripts/hook-violations-summary --since <iso-or-date> # only entries newer
#   scripts/hook-violations-summary --recent N            # last N entries
#   scripts/hook-violations-summary -h | --help

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || echo "$PWD")"
log_file="$repo_root/.claude/hook-violations.log"

usage() {
  cat >&2 <<EOF
Usage: hook-violations-summary [options]

  --rule <slug>      Filter to one rule (e.g. "br-close-outside-review")
  --since <when>     ISO-8601 or anything `date -d` parses (e.g. "1 hour ago")
  --recent N         Show the last N entries (default: rollup only)
  -h, --help

Default: print rule-frequency count over the whole log.
EOF
  exit 2
}

filter_rule=""
filter_since=""
recent=""

while (( $# > 0 )); do
  case "$1" in
    --rule) filter_rule="${2:-}"; shift 2 ;;
    --since) filter_since="${2:-}"; shift 2 ;;
    --recent) recent="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    *) echo "unknown option: $1" >&2; usage ;;
  esac
done

if [[ ! -f "$log_file" ]]; then
  echo "no log at $log_file" >&2
  exit 0
fi

# Compose a jq filter chain.
filter='.'
if [[ -n "$filter_rule" ]]; then
  filter+=" | select(.rule == \"$filter_rule\")"
fi
if [[ -n "$filter_since" ]]; then
  since_epoch="$(date -d "$filter_since" +%s 2>/dev/null || echo 0)"
  if [[ "$since_epoch" == "0" ]]; then
    echo "could not parse --since value: $filter_since" >&2
    exit 2
  fi
  filter+=" | select((.ts | fromdateiso8601) >= $since_epoch)"
fi

filtered="$(jq -c "$filter" "$log_file" 2>/dev/null)"
if [[ -z "$filtered" ]]; then
  echo "no matching entries"
  exit 0
fi

total="$(printf '%s\n' "$filtered" | grep -c '^.' || true)"

if [[ -n "$recent" ]]; then
  printf 'Recent %d of %d entries:\n\n' "$recent" "$total"
  printf '%s\n' "$filtered" | tail -n "$recent" | jq -r \
    '"\(.ts)  \(.rule)  \(.skill // "-")  \(.command | .[0:80])"'
  exit 0
fi

if [[ -n "$filter_rule" ]]; then
  printf 'All %d entries for rule "%s":\n\n' "$total" "$filter_rule"
  printf '%s\n' "$filtered" | jq -r \
    '"\(.ts)  \(.skill // "-")  \(.head)  \(.command | .[0:100])"'
  exit 0
fi

printf 'Rule firing counts (total %d entries):\n\n' "$total"
printf '%s\n' "$filtered" | jq -r '.rule' | sort | uniq -c | sort -rn | \
  awk '{ printf "  %5d  %s\n", $1, $2 }'

printf '\nBy skill:\n\n'
printf '%s\n' "$filtered" | jq -r '.skill // "-"' | sort | uniq -c | sort -rn | \
  awk '{ printf "  %5d  %s\n", $1, $2 }'
